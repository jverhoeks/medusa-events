{
  "name": "@jverhoeks/medusa-events",
  "version": "0.1.0-rc.2",
  "description": "Manage and publish event listings with Medusa v2",
  "license": "MIT",
  "author": "Jacob Verhoeks",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverhoeks/medusa-events.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    ".medusa/server",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "scripts": {
    "build": "medusa plugin:build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-other",
    "events",
    "calendar"
  ],
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "^5.64.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@swc/core": "^1.16.18",
    "@tanstack/react-query": "5.104.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "@medusajs/types": "2.21.2"
  },
  "overrides": {
    "qs": "6.16.1",
    "postcss": "8.5.30"
  }
}
